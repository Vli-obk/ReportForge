# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=ReportForge
VERSION=1.0.0

# Security
SECRET_KEY=your-secret-key-change-in-production-use-a-strong-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/pdf_analytics
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pdf_analytics
POSTGRES_PORT=5432

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:4028","http://localhost:3000"]

# File Upload
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./uploads

# OCR Settings
TESSERACT_CMD=

# Gemini AI Settings
GEMINI_API_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1beta
GEMINI_MODEL=gemini-1.5-pro
GEMINI_API_KEY=
